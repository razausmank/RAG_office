# Database Connection Configuration
# Use ONE of the following (don't define DATABASE_URL twice).

# 1. SQLite (Development Default)
DATABASE_URL=sqlite:///./orders.db

# 2. PostgreSQL (Production / Scale)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Groq API key (https://console.groq.com/keys) — used by agent.py for the chat model
GROQ_API_KEY=
